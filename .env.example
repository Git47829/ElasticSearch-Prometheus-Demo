# =============================================================================
# Root .env.example — consumed by docker-compose.yml
# Copy to `.env` and edit; docker compose will pick it up automatically.
# Per-service env files (logger-client/.env) override these for local `go run`.
# =============================================================================

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
ES_HTTP_PORT=9200
ES_TRANSPORT_PORT=9300
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_XPACK_SECURITY=false
# Only used when ES_XPACK_SECURITY=true
ES_PASSWORD=
# Lock ES heap in RAM. Leave false on Docker Desktop (macOS/Win) — host kernel
# blocks the rlimit and container fails with "error setting rlimit type 8".
# Set true only on Linux hosts where you control ulimits.
ES_MEMORY_LOCK=false

# -----------------------------------------------------------------------------
# Elasticsearch Prometheus exporter
# (https://github.com/prometheus-community/elasticsearch_exporter)
# -----------------------------------------------------------------------------
ES_EXPORTER_URI=http://elasticsearch:9200
ES_EXPORTER_PORT=9114

# -----------------------------------------------------------------------------
# Logger client (Go backend)
# -----------------------------------------------------------------------------
# Host-side port mapping only; container always listens on 8080.
LOGGER_PORT=8080
# Consumed by the Go process (overrides the container-network defaults if set):
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (nginx serving Alpine.js + htmx UI)
# -----------------------------------------------------------------------------
FRONTEND_PORT=8081

# -----------------------------------------------------------------------------
# Elasticvue (web UI for Elasticsearch)
# -----------------------------------------------------------------------------
ELASTICVUE_PORT=8082

# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false
